generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Employee {
  id           String   @id @default(cuid())
  firstName    String
  lastName     String
  position     String   @default("")
  birthDate    String   @default("")
  phone        String   @default("")
  email        String   @unique
  login        String   @unique
  passwordHash String?
  role         String
  department   String   @default("")
  notes        String   @default("")
  permissions  Json     @default("[]")
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model KnowledgeArticle {
  id        String   @id @default(cuid())
  title     String
  slug      String   @unique
  category  String
  summary   String   @default("")
  content   String
  status    String
  audience  Json     @default("[]")
  updatedBy String   @default("admin")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Product {
  id          String   @id @default(cuid())
  code        String   @default("")
  group       String   @default("")
  variantColor String  @default("")
  slug        String   @unique
  name        String
  nameI18n    Json?
  status      String   @default("РђРєС‚РёРІРµРЅ")
  category    String
  brand       String   @default("")
  size        String   @default("")
  centimeters String   @default("")
  ageGroup    String   @default("")
  audience    String   @default("")
  season      String   @default("")
  price       Float
  oldPrice    Float?
  stock       Int      @default(0)
  material    String   @default("")
  colors      Json
  badge       String?
  description String   @default("")
  descriptionI18n Json?
  warehouseStock Json   @default("[]")
  image       String
  images      Json     @default("[]")
  features    Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Post {
  id           String   @id @default(cuid())
  slug         String   @unique
  title        String
  titleI18n    Json?
  category     String
  excerpt      String
  excerptI18n  Json?
  cover        String
  content      Json
  contentBlocks Json?
  published    Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Category {
  id        String   @id @default(cuid())
  name      String   @unique
  nameI18n  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Brand {
  id        String   @id @default(cuid())
  name      String   @unique
  nameI18n  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Season {
  id        String   @id @default(cuid())
  name      String   @unique
  nameI18n  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Warehouse {
  id        String   @id @default(cuid())
  name      String   @unique
  nameI18n  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Color {
  id        String   @id @default(cuid())
  name      String   @unique
  nameI18n  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Size {
  id        String   @id @default(cuid())
  name      String   @unique
  nameI18n  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Material {
  id        String   @id @default(cuid())
  name      String   @unique
  nameI18n  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Order {
  id               String   @id @default(cuid())
  orderNumber      Int      @unique
  customerName     String
  phone            String
  email            String
  comment          String   @default("")
  managerComment   String   @default("")
  deliveryMethod   String
  paymentMethod    String
  region           String   @default("")
  city             String   @default("")
  novaPoshtaType   String   @default("")
  novaPoshtaBranch String   @default("")
  courierAddress   String   @default("")
  status           String
  total            Float
  items            Json
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Client {
  id           String   @id @default(cuid())
  name         String
  phone        String
  email        String
  orderIds     Json
  orderNumbers Json
  totalSpent   Float    @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model SiteSettings {
  id               String   @id @default(cuid())
  key              String   @unique
  heroBadge        String   @default("")
  heroTitle        String   @default("")
  heroDescription  String   @default("")
  heroPrimaryText  String   @default("")
  heroPrimaryLink  String   @default("")
  heroSecondaryText String  @default("")
  heroSecondaryLink String  @default("")
  heroImageSrc     String   @default("")
  heroImageAlt     String   @default("")
  heroBenefits     Json     @default("[]")
  heroBadgeI18n    Json?
  heroTitleI18n    Json?
  heroDescriptionI18n Json?
  heroPrimaryTextI18n Json?
  heroSecondaryTextI18n Json?
  heroImageAltI18n Json?
  heroBenefitsI18n Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

